# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/sagradocorazon

# MinIO (object storage) - optional
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# SMTP (email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password

# VAPID keys for Web Push (generate and paste here)
VAPID_PUBLIC_KEY=your_vapid_public
VAPID_PRIVATE_KEY=your_vapid_private

# Google OAuth2 credentials (for Calendar integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/google/callback

# SECRET for tokens
SECRET_KEY=change-me

# Admin seeding (used at startup if not present)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123


